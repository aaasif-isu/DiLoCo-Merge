# Python bytecode & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
diloco-env/

# Archive, and configs
archive/
configs/
data/

# Experiment outputs, checkpoints, & tracking
outputs/
results/
checkpoints/
wandb/
*.pt
*.pth
*.ckpt
*.log

# Slurm & runtime logs (keep directory, ignore contents)
logs/
scripts/logs/*
!scripts/logs/.gitkeep

# Datasets & binary token shards (note: data/*.py is the Python package and is tracked)
datasets/
*.npy
*.bin

# Caches & temporary directories
.cache/
.triton/
.pytest_cache/
.ruff_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Credentials & secrets
.env
.env.*
*.key
.netrc

